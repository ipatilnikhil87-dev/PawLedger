# PawLedger Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_pawledger_dev_key_do_not_use_in_prod
JWT_REFRESH_SECRET=refresh_secret_pawledger_dev_key_change_me
CLIENT_URL=http://localhost:5173

# Adapters
SMS_GATEWAY_ADAPTER=mock
# Options: mock, twilio, gupshup
SMS_API_KEY=
SMS_SENDER_ID=PAWLED

OCR_ADAPTER=mock
# Options: mock, google_cloud_vision, tesseract_cloud
OCR_API_KEY=

# Database
DATABASE_FILE=./pawledger.sqlite
